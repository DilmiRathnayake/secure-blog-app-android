<?xml version="1.0" encoding="utf-8"?>
<!-- App logo for splash/onboarding: white rounded square with the gradient bubble mark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="28dp" />
            <size android:width="96dp" android:height="96dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_logo_glyph" android:gravity="center" android:width="56dp" android:height="56dp" />
</layer-list>
