<?xml version="1.0" encoding="utf-8"?>
<!-- Cards gently shrink while pressed (micro-interaction), then spring back. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="120" android:propertyName="scaleX" android:valueTo="0.975" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="scaleY" android:valueTo="0.975" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="200" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="200" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
