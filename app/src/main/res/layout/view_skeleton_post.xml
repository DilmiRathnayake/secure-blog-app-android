<?xml version="1.0" encoding="utf-8"?>
<!-- Loading skeleton shaped like a post card (pulsed by Shimmer.java). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_skeleton_card"
    android:orientation="horizontal"
    android:padding="14dp">

    <View
        android:layout_width="@dimen/thumb_size"
        android:layout_height="@dimen/thumb_size"
        android:background="@drawable/bg_skeleton" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginEnd="48dp"
            android:background="@drawable/bg_skeleton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_skeleton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="80dp"
            android:background="@drawable/bg_skeleton" />

        <View
            android:layout_width="72dp"
            android:layout_height="18dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_skeleton" />
    </LinearLayout>
</LinearLayout>
