<?xml version="1.0" encoding="utf-8"?>
<!-- Gallery: header with Camera / Gallery upload cards, then a grid of every attached photo. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/gallery_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_subtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="@dimen/space_m"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_camera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <ImageView
                        android:layout_width="@dimen/icon_tile"
                        android:layout_height="@dimen/icon_tile"
                        android:background="@drawable/bg_glass"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/on_gradient" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/gallery_camera"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/on_gradient" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gallery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <ImageView
                        android:layout_width="@dimen/icon_tile"
                        android:layout_height="@dimen/icon_tile"
                        android:background="@drawable/bg_icon_tile"
                        android:backgroundTint="@color/bs_secondary_container"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_photo_library"
                        app:tint="@color/brand_purple" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/gallery_pick"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_list_enter"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="14dp"
            android:paddingBottom="@dimen/space_xl" />

        <include
            android:id="@+id/empty"
            layout="@layout/view_empty_state"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
