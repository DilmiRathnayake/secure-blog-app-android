<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard: gradient hero with avatar, greeting, status and search; stats; recent posts. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/fab_bottom_space">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingTop="@dimen/space_l"
                android:paddingBottom="64dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar"
                        android:layout_width="@dimen/avatar_s"
                        android:layout_height="@dimen/avatar_s"
                        android:background="@android:color/white"
                        android:contentDescription="@string/cd_open_profile"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.CH.Circle"
                        app:strokeColor="@color/glass_stroke"
                        app:strokeWidth="2dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/on_gradient_muted" />

                        <TextView
                            android:id="@+id/user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="@color/on_gradient" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/status_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_glass"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/space_m"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/on_gradient"
                        app:drawableTint="@color/on_gradient" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/search_pill"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/search_pill_height"
                    android:layout_marginTop="@dimen/space_xl"
                    android:background="@drawable/bg_search_pill"
                    android:clickable="true"
                    android:contentDescription="@string/cd_open_search"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_l">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:text="@string/home_search_hint"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOutline" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stats overlap the bottom of the hero for a layered look. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="-44dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stat_total"
                    layout="@layout/item_stat_card" />

                <include
                    android:id="@+id/stat_offline"
                    layout="@layout/item_stat_card" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stat_uploaded"
                    layout="@layout/item_stat_card" />

                <include
                    android:id="@+id/stat_drafts"
                    layout="@layout/item_stat_card" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginEnd="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/home_recent"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_all"
                    style="@style/Widget.CH.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_view_all"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconGravity="textEnd" />
            </LinearLayout>

            <include
                android:id="@+id/skeleton"
                layout="@layout/view_skeleton_list" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutAnimation="@anim/layout_list_enter"
                android:nestedScrollingEnabled="false" />

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty_state"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_padding"
        android:text="@string/action_new_post"
        app:icon="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
