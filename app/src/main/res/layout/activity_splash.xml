<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient splash: logo pops in, name fades up, indeterminate loader runs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_primary">

    <View
        android:id="@+id/glow_top"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-120dp"
        android:layout_marginEnd="-120dp"
        android:alpha="0.12"
        android:background="@drawable/bg_circle" />

    <View
        android:id="@+id/glow_bottom"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-100dp"
        android:layout_marginBottom="-80dp"
        android:alpha="0.08"
        android:background="@drawable/bg_circle" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:elevation="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_mark" />

        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="@color/on_gradient" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/app_tagline"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/on_gradient_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loader_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/on_gradient"
            app:indicatorSize="36dp"
            app:trackColor="@color/glass_stroke"
            app:trackThickness="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/splash_loading"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/on_gradient_muted" />
    </LinearLayout>
</FrameLayout>
