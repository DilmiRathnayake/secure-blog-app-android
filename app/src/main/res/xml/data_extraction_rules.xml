<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules: publishing settings (blog selection) are device-specific. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="publish_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="publish_settings.xml" />
    </device-transfer>
</data-extraction-rules>
