<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed only for publishing to Blogger; all post management works offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        No CAMERA or storage permission is declared on purpose:
        - Photos are taken by the device camera app via ACTION_IMAGE_CAPTURE, which writes
          into a FileProvider URI we grant to it. Declaring CAMERA would force a runtime request.
        - Gallery images come from the system Photo Picker, which needs no permission.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        Package visibility (Android 11+): the share sheet shows WhatsApp / Facebook / Messenger
        shortcuts only when those apps are installed, so we must be allowed to see them.
    -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.orca" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".ConnectHubApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlogSpace"
        tools:targetApi="36">

        <!-- Launcher: animated splash, then onboarding / profile setup on first run. -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.BlogSpace.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.OnboardingActivity" android:exported="false" />
        <activity
            android:name=".ui.ProfileSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity
            android:name=".ui.ImagePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.BlogSpace.Immersive" />
        <activity
            android:name=".ui.PublishSettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.PostDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.EditPostActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Exposes app-private image files to the camera app and share targets as content:// URIs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
